generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REQUESTER
  REVIEWER
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  RETURNED
}

enum RequestHistoryAction {
  CREATED
  SUBMITTED
  RESUBMITTED
  EDITED
  APPROVED
  REJECTED
  RETURNED
}

model User {
  id                 Int               @id @default(autoincrement())
  email              String            @unique
  passwordHash       String
  name               String
  role               UserRole
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  submittedRequests  PurchaseRequest[] @relation("Requester")
  assignedRequests   PurchaseRequest[] @relation("Reviewer")
  historyEntries     RequestHistory[]  @relation("HistoryActor")
}

model PurchaseRequest {
  id            Int                   @id @default(autoincrement())
  requestNumber String                @unique
  title         String                @db.VarChar(150)
  description   String                @db.VarChar(2000)
  amount        Decimal               @db.Decimal(12, 2)
  justification String                @db.VarChar(2000)
  status        PurchaseRequestStatus @default(DRAFT)
  requesterId   Int
  reviewerId    Int
  submittedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  requester     User                  @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewer      User                  @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  history       RequestHistory[]

  @@index([requesterId])
  @@index([reviewerId])
  @@index([status])
  @@index([createdAt])
}

model RequestHistory {
  id        Int                  @id @default(autoincrement())
  requestId Int
  actorId   Int
  action    RequestHistoryAction
  fromStatus PurchaseRequestStatus?
  toStatus   PurchaseRequestStatus?
  reason    String?              @db.VarChar(2000)
  createdAt DateTime             @default(now())
  request   PurchaseRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User                 @relation("HistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorId])
}
