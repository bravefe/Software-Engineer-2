# PostgreSQL connection string. Replace the local placeholder with a secret in Cloud Run.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
# HTTP port (Cloud Run sets this automatically).
PORT=3000
# Runtime environment; set to production in Cloud Run.
NODE_ENV=development
# Allowed browser origins, comma-separated.
CORS_ORIGIN=http://localhost:5173
# Required before running `npm run db:seed --workspace server`.
SEED_USER_PASSWORD=replace-with-a-local-seed-password
